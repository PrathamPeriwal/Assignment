{
  "info": {
    "name": "Office Hours",
    "description": "Run this collection from top to bottom with Collection Runner. Test scripts save teacherId, userId, and sessionId. Create teacher stamps a runId into the email so a second run does not collide with seed data. Session times are tomorrow 10:00-11:00 local, computed when the request runs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "startTime", "value": "" },
    { "key": "endTime", "value": "" },
    { "key": "dateTimestamp", "value": "" },
    { "key": "badStart", "value": "" },
    { "key": "badEnd", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('reports ok', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Teachers",
      "item": [
        {
          "name": "Create teacher",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('runId', String(Date.now()));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('returns the teacher', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.message).to.eql('Teacher created');",
                  "  pm.expect(body.data._id).to.match(/^[0-9a-f]{24}$/i);",
                  "  pm.expect(body.data.fullName).to.eql('Helena Costa');",
                  "  pm.expect(body.data.email).to.eql('helena.' + pm.collectionVariables.get('runId') + '@example.com');",
                  "  pm.expect(body.data.specialization).to.eql('Compilers');",
                  "  pm.expect(body.data.experience).to.eql(12);",
                  "});",
                  "pm.collectionVariables.set('teacherId', body.data._id);",
                  "if (pm.environment.get('baseUrl') !== undefined) {",
                  "  pm.environment.set('teacherId', body.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Helena Costa\",\n  \"email\": \"Helena.{{runId}}@Example.com\",\n  \"specialization\": \"Compilers\",\n  \"experience\": 12\n}"
            },
            "url": "{{baseUrl}}/teachers"
          }
        },
        {
          "name": "Create teacher with a duplicate email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "pm.test('conflict envelope', function () {",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.error.code).to.eql('CONFLICT');",
                  "  pm.expect(body.error.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Helena Costa\",\n  \"email\": \"helena.{{runId}}@example.com\",\n  \"specialization\": \"Compilers\",\n  \"experience\": 12\n}"
            },
            "url": "{{baseUrl}}/teachers"
          }
        },
        {
          "name": "List teachers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('lists teachers', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  const id = pm.collectionVariables.get('teacherId');",
                  "  pm.expect(body.data.some(function (row) { return row._id === id; })).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teachers"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('returns the user', function () {",
